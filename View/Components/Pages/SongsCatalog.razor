@* 
   דף נוסף: מאגר השירים והטאבים הכללי (Songs Catalog)
   תיאור: קטלוג חיפוש וסינון שירים הזמינים לתרגול עבור משתמשי המערכת.
   הרשאות: מוגן למשתמשים מחוברים (RoleId >= 2).
*@

@page "/songs-catalog"
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>מאגר שירים | instruMETAL</PageTitle>

@if (isAuthorized)
{
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-8 dir-rtl">
        
        <!-- כותרת הדף -->
        <div class="border-b border-purple-900/20 pb-6">
            <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
                מאגר השירים והטאבים 🎶
            </h1>
            <p class="text-xs sm:text-sm text-zinc-400 mt-1">
                חפש וסנן שירים מתוך ספריית הטאבים הרשמית של המורים.
            </p>
        </div>

        <!-- סרגל חיפוש וסינון -->
        <div class="metal-card p-4 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="w-full md:w-1/2 relative">
                <input type="text" placeholder="חפש לפי שם שיר, אמן או מורה..." class="w-full px-4 py-2.5 bg-zinc-950 border border-zinc-800 rounded-xl text-xs text-white pr-10" />
                <span class="material-symbols-outlined absolute right-3 top-2.5 text-zinc-500">search</span>
            </div>
            <div class="flex items-center gap-2 w-full md:w-auto overflow-x-auto pb-2 md:pb-0">
                <button class="px-3 py-1.5 rounded-lg bg-purple-700 text-white text-xs font-semibold">הכל</button>
                <button class="px-3 py-1.5 rounded-lg bg-zinc-900 text-zinc-400 text-xs hover:text-white">Thrash Metal</button>
                <button class="px-3 py-1.5 rounded-lg bg-zinc-900 text-zinc-400 text-xs hover:text-white">Heavy Metal</button>
                <button class="px-3 py-1.5 rounded-lg bg-zinc-900 text-zinc-400 text-xs hover:text-white">Progressive</button>
            </div>
        </div>

        <!-- גריד השירים -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <LessonCard Title="Master of Puppets" Artist="Metallica" TeacherName="אלכס גורדון" Genre="Thrash Metal" Bpm="212" Difficulty="מתקדם" ActionLabel="פציחת שיעור" />
            <LessonCard Title="The Trooper" Artist="Iron Maiden" TeacherName="דניאל לוי" Genre="Heavy Metal" Bpm="160" Difficulty="בינוני" ActionLabel="פציחת שיעור" />
            <LessonCard Title="Holy Wars" Artist="Megadeth" TeacherName="אלכס גורדון" Genre="Thrash Metal" Bpm="160" Difficulty="מתקדם" ActionLabel="פציחת שיעור" />
            <LessonCard Title="Crazy Train" Artist="Ozzy Osbourne" TeacherName="יוסי כהן" Genre="Heavy Metal" Bpm="138" Difficulty="בינוני" ActionLabel="פציחת שיעור" />
            <LessonCard Title="Pull Me Under" Artist="Dream Theater" TeacherName="אלכס גורדון" Genre="Progressive" Bpm="102" Difficulty="מומחה" ActionLabel="פציחת שיעור" />
            <LessonCard Title="Paranoid" Artist="Black Sabbath" TeacherName="דניאל לוי" Genre="Heavy Metal" Bpm="164" Difficulty="מתחיל" ActionLabel="פציחת שיעור" />
        </div>
    </div>
}

@code {
    private bool isAuthorized = false;

    protected override void OnInitialized()
    {
        if (!Session.IsLoggedIn)
        {
            Navigation.NavigateTo("login");
            return;
        }

        isAuthorized = true;
    }
}