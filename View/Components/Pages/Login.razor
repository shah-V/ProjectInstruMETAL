<div class="pt-2">
<button class="w-full py-3.5 px-6 rounded-lg bg-primary-container text-surface-container-lowest font-headline-sm text-headline-sm font-bold flex items-center justify-center gap-2 hover:bg-primary-fixed-dim hover:shadow-[0_0_24px_rgba(0,229,255,0.6)] active:scale-[0.98] transition-all duration-150 cursor-pointer" type="submit">
<span class="material-symbols-outlined" data-icon="login">login</span>
