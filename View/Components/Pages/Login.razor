<div class="absolute inset-0 bg-[radial-gradient(#3b494c_1px,transparent_1px)] [background-size:32px_32px] opacity-15"></div>
</div>

<!-- MAIN CANVAS: CENTERED LOGIN CARD -->
<main class="relative z-10 flex-1 flex items-center justify-center px-4 py-12 md:py-16">
<div class="w-full max-w-lg mx-auto">
