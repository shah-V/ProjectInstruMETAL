<div class="flex items-center justify-between pt-1">
<label class="flex items-center gap-2.5 cursor-pointer select-none">
<input class="w-4 h-4 rounded bg-surface-container-high border-outline-variant/60 text-primary-container focus:ring-primary-container/30 focus:ring-offset-0 focus:ring-offset-transparent cursor-pointer" type="checkbox">
<span class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors">
