@page "/login"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Model
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>התחברות | instruMETAL</PageTitle>

<!-- Ambient Background Aura -->
<div class="fixed inset-0 pointer-events-none z-0">
    <div class="absolute -top-32 right-1/4 w-[32rem] h-[32rem] bg-purple-900/15 rounded-full blur-[150px]"></div>
    <div class="absolute top-1/2 left-10 w-96 h-96 bg-[#4c1d95]/10 rounded-full blur-[140px]"></div>
    <div class="absolute -bottom-24 right-1/3 w-80 h-80 bg-violet-950/20 rounded-full blur-[130px]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(rgba(147,51,234,0.05)_1px,transparent_1px)] [background-size:36px_36px] opacity-40"></div>
</div>

<!-- Main Canvas: Centered Login Card -->
<main class="relative z-10 flex-1 flex items-center justify-center px-4 py-12 md:py-16">
    <div class="w-full max-w-[440px] mx-auto">
        <div class="border border-purple-500/10 bg-[#120d1d]/70 backdrop-blur-xl p-8 sm:p-9 shadow-2xl shadow-purple-950/20 relative rounded-2xl">
            
            <!-- Card Header -->
            <div class="text-center mb-8">
                <div class="mb-4 flex items-center justify-center">
                    <img alt="instruMETAL Logo" class="w-14 h-14 object-contain mx-auto drop-shadow-[0_0_16px_rgba(168,85,247,0.35)]" src="images/InstrumentalLogo.png">
                </div>
                <div class="font-label-sm text-xs uppercase tracking-widest text-purple-400/70 mb-2">
                    instruMETAL STUDIO
                </div>
                <h1 class="font-headline-lg text-2xl text-white font-semibold tracking-tight mb-2">
                    כניסה למערכת
                </h1>
                <p class="font-body-md text-xs text-zinc-400 max-w-sm mx-auto leading-relaxed">
                    ברוכים השבים! התחברו כדי להמשיך באימון הטאבים והשירים שלכם
                </p>
            </div>

            <!-- Error Alert -->
            @if (errorMessage != null)
            {
                <div class="p-3 mb-4 rounded-xl bg-red-950/40 border border-red-500/30 text-red-300 font-body-md text-xs text-right">
                    @errorMessage
                </div>
            }

            <!-- Form -->
            <form class="space-y-4" @onsubmit:preventDefault>
                
                <!-- Field 1: Username / Email -->
                <div class="space-y-1.5 text-right">
                    <label class="block font-label-md text-xs text-zinc-300 font-medium flex items-center justify-between" for="identifier">
                        <span>שם משתמש / כתובת אימייל</span>
                        <span class="font-label-sm text-[11px] text-zinc-500 font-normal">חובה</span>
                    </label>
                    <div class="relative rounded-lg group">
                        <input class="w-full px-4 py-2.5 bg-zinc-950/80 border border-purple-500/15 text-zinc-100 placeholder-zinc-600 font-label-md text-xs focus:outline-none focus:border-purple-500/60 focus:ring-1 focus:ring-purple-500/20 transition-all duration-150 pl-10 rounded-xl"
                               dir="ltr"
                               id="identifier"
                               placeholder="user@metal.com / username"
                               @bind="identifier"
                               type="text" />
                        <div class="absolute left-3 top-1/2 -translate-y-1/2 text-zinc-500 group-focus-within:text-purple-400 transition-colors flex items-center pointer-events-none">
                            <span class="material-symbols-outlined text-[19px]">mail</span>
                        </div>
                    </div>
                </div>

                <!-- Field 2: Password -->
                <div class="space-y-1.5 text-right">
                    <div class="flex items-center justify-between">
                        <label class="block font-label-md text-xs text-zinc-300 font-medium" for="password">
                            סיסמה
                        </label>
                        <a class="font-label-sm text-[11px] text-purple-400/80 hover:text-purple-300 hover:underline transition-colors duration-150" href="#">
                            שכחת סיסמה?
                        </a>
                    </div>
                    <div class="relative rounded-lg group">
                        <input class="w-full px-4 py-2.5 bg-zinc-950/80 border border-purple-500/15 text-zinc-100 placeholder-zinc-600 font-label-md text-xs focus:outline-none focus:border-purple-500/60 focus:ring-1 focus:ring-purple-500/20 transition-all duration-150 pl-10 rounded-xl"
                               dir="ltr"
                               id="password"
                               placeholder="••••••••••••"
                               @bind="password"
                               type="password" />
                        <div class="absolute left-3 top-1/2 -translate-y-1/2 text-zinc-500 group-focus-within:text-purple-400 transition-colors flex items-center pointer-events-none">
                            <span class="material-symbols-outlined text-[19px]">key</span>
                        </div>
                    </div>
                </div>

                <!-- Checkbox Option: Remember Me -->
                <div class="flex items-center justify-between pt-1">
                    <label class="flex items-center gap-2 cursor-pointer select-none">
                        <input type="checkbox"
                               @bind="rememberMe"
                               class="w-4 h-4 rounded bg-zinc-950 border-purple-900/40 text-purple-600 focus:ring-purple-500/20 focus:ring-offset-0 focus:ring-offset-transparent cursor-pointer" />
                        <span class="font-body-sm text-xs text-zinc-400 hover:text-zinc-300 transition-colors">
                            זכור אותי במכשיר זה
                        </span>
                    </label>
                    <span class="font-label-sm text-[11px] text-zinc-600">30 יום</span>
                </div>

                <!-- Submit Button -->
                <div class="pt-3">
                    <button type="button"
                            disabled="@isBusy"
                            @onclick="LoginAsync"
                            class="w-full py-3 px-6 bg-purple-700 hover:bg-purple-600 text-white font-headline-sm text-sm font-semibold flex items-center justify-center gap-2 active:scale-[0.99] transition-all duration-150 cursor-pointer shadow-sm hover:shadow-purple-950/40 rounded-xl disabled:opacity-50">
                        <span class="material-symbols-outlined text-[19px]">login</span>
                        <span>@(isBusy ? "מתחבר..." : "התחברות")</span>
                    </button>
                </div>
            </form>

            <!-- Registration Redirect -->
            <div class="pt-6 border-t border-purple-950/60 text-center mt-7">
                <p class="font-body-md text-xs text-zinc-400">
                    עדיין אין לך חשבון? 
                    <a href="register" class="font-medium text-purple-400 hover:text-purple-300 hover:underline underline-offset-4 mr-1 transition-all">
                        הרשם עכשיו בחינם
                    </a>
                </p>
            </div>
        </div>
    </div>
</main>

@code {
    private string identifier = string.Empty;
    private string password = string.Empty;
    private bool rememberMe = false;

    private string? errorMessage;
    private bool isBusy = false;

    private async Task LoginAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(identifier) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "יש למלא שם משתמש/אימייל וסיסמה.";
            return;
        }

        isBusy = true;

        try
        {
            var loginDto = new { Identifier = identifier.Trim(), Password = password };
            HttpResponseMessage response = await Http.PostAsJsonAsync("api/users/login", loginDto);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = "שם המשתמש/האימייל או הסיסמה אינם נכונים.";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "השרת לא זמין כרגע. נסו שוב בעוד רגע.";
        }
        finally
        {
            isBusy = false;
        }
    }
}