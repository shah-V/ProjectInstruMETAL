<div class="absolute top-0 right-0 left-0 h-[2px] bg-gradient-to-l from-transparent via-primary-container to-transparent opacity-80"></div>
<div class="absolute -top-12 left-1/2 -translate-x-1/2 w-48 h-20 bg-primary-container/20 blur-2xl pointer-events-none"></div>
<!-- Card Header -->
<div class="text-center mb-8">
<!-- Cyber Plectrum Icon Badge -->
<div class="mb-4 flex items-center justify-center hover:scale-105 transition-transform duration-200"><Logo /></div>
<div class="font-label-sm text-label-sm uppercase tracking-widest text-primary-fixed-dim mb-1">
            instruMETAL STUDIO
          </div>
<h1 class="font-headline-lg text-headline-lg text-on-surface font-bold tracking-tight mb-2">
            כניסה למערכת
          </h1>
<p class="font-body-md text-body-md text-on-surface-variant max-w-sm mx-auto leading-relaxed">
            ברוכים השבים! התחברו כדי להמשיך באימון הטאבים והשירים שלכם
          </p>
</div>
<!-- Login Form -->
<form class="space-y-5" onsubmit="event.preventDefault();">
<!-- Field 1: Username / Email -->
<div class="space-y-1.5 text-right">
  <label class="block font-headline-sm text-label-md text-on-surface font-medium flex items-center justify-between" for="identifier">
    <span>שם משתמש / כתובת אימייל</span>
    <span class="font-label-sm text-label-sm text-outline font-normal">חובה</span>
  </label>
  <div class="relative rounded-lg group">
<input style="padding-left: 40px !important;" class="glass-input w-full px-4 py-3 rounded-lg border border-white/10 text-on-surface placeholder-outline font-label-md text-label-md focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container/50 transition-all duration-150" dir="ltr" id="identifier" placeholder="user@metal.com / username" required="" type="text">    <div class="absolute left-3.5 top-1/2 -translate-y-1/2 text-outline-variant group-focus-within:text-primary-container transition-colors flex items-center pointer-events-none">
      <span class="material-symbols-outlined" data-icon="mail">mail</span>
    </div>
  </div>
</div>

<!-- Field 2: Password -->
<div class="space-y-1.5 text-right">
  <div class="flex items-center justify-between">
    <label class="block font-headline-sm text-label-md text-on-surface font-medium" for="password">
