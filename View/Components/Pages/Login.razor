    </label>
    <a class="font-label-sm text-label-sm text-secondary-fixed-dim hover:text-secondary hover:underline transition-colors duration-150" href="#">
      שכחת סיסמה?
    </a>
  </div>
  <div class="relative rounded-lg group">
<input style="padding-left: 40px !important;" class="glass-input w-full px-4 py-3 rounded-lg border border-white/10 text-on-surface placeholder-outline font-label-md text-label-md focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container/50 transition-all duration-150" dir="ltr" id="password" placeholder="••••••••••••" required="" type="password">    <div class="absolute left-3.5 top-1/2 -translate-y-1/2 text-outline-variant group-focus-within:text-primary-container transition-colors flex items-center pointer-events-none">
      <span class="material-symbols-outlined" data-icon="key">key</span>
    </div>
  </div>
</div>
