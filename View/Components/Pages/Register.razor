@page "/register"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Net.Mail
@using Model
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>הרשמה ל-instruMETAL | הצטרפו לקהילת המטאל והרוק המתקדם</PageTitle>

<!-- Atmospheric Background Ambient Lights -->
<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
    <div class="absolute -top-44 left-1/2 -translate-x-1/2 w-[800px] h-[550px] bg-purple-900/20 rounded-full blur-[160px]"></div>
    <div class="absolute -bottom-36 -left-20 w-[500px] h-[500px] bg-[#4c1d95]/15 rounded-full blur-[150px]"></div>
    <div class="absolute -bottom-24 -right-24 w-[450px] h-[450px] bg-[#2e1065]/25 rounded-full blur-[140px]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(rgba(168,85,247,0.04)_1px,transparent_1px)] [background-size:32px_32px]"></div>
</div>

<!-- Main Registration Section -->
<main class="flex-1 flex items-center justify-center px-4 sm:px-6 lg:px-8 py-10 md:py-16 relative z-10">
    <div class="w-full max-w-lg mx-auto">
        <div class="relative bg-[#0d0a15]/90 backdrop-blur-2xl p-7 sm:p-9 border border-purple-500/15 shadow-[0_20px_50px_rgba(0,0,0,0.85)] purple-subtle-glow overflow-hidden rounded-3xl">
            <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-80 h-40 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>

            <!-- Title & Logo -->
            <div class="text-center mb-7 relative z-10">
                <div class="inline-flex items-center justify-center mb-3">
                    <div class="relative flex items-center justify-center p-2 rounded-2xl bg-purple-950/20 border border-purple-500/20 shadow-[0_0_24px_rgba(124,58,237,0.25)]">
                        <img src="images/InstrumentalLogo.png" alt="instruMETAL Logo" class="w-16 h-16 sm:w-20 sm:h-20 object-contain drop-shadow-[0_0_16px_rgba(168,85,247,0.45)]">
                    </div>
                </div>
                <div class="font-headline-sm text-xs font-semibold tracking-widest uppercase text-purple-400/90 mb-1">instruMETAL</div>
                <h1 class="font-headline-lg text-2xl font-bold text-white tracking-tight mt-1 mb-2">הרשמה ל-instruMETAL</h1>
                <p class="font-body-md text-xs text-on-surface-variant max-w-sm mx-auto leading-relaxed">
                    הצטרפו למאגר הטאבים והלימוד המקצועי לגיטרה, בס ותופים
                </p>
            </div>

            <!-- Error / Success Alerts -->
            @if (errorMessage != null)
            {
                <div class="p-3 mb-4 rounded-xl bg-red-950/40 border border-red-500/30 text-red-300 font-body-md text-xs">
                    @errorMessage
                </div>
            }

            @if (isRegistered)
            {
                <div class="p-3 mb-4 rounded-xl bg-purple-950/40 border border-purple-500/40 text-purple-200 font-body-md text-xs">
                    <strong>ההרשמה הצליחה!</strong> מעבירים אותך לדף הכניסה בעוד <strong>@secondsLeft</strong> שניות...
                </div>
            }

            <!-- Form -->
            <form class="space-y-4 relative z-10" @onsubmit:preventDefault>
                
                <!-- Username -->
                <Field Id="username"
                       Label="שם משתמש"
                       Hint="באנגלית ומספרים בלבד"
                       Icon="person"
                       Placeholder="e.g. shred_master"
                       @bind-Value="username" />

                <!-- Email -->
                <Field Id="email"
                       Label="כתובת אימייל"
                       Icon="mail"
                       Type="email"
                       Placeholder="yourname@domain.com"
                       @bind-Value="email" />

                <!-- Password -->
                <Field Id="password"
                       Label="סיסמה"
                       Hint="מינימום 8 תווים"
                       Icon="lock"
                       Type="password"
                       Placeholder="••••••••••••"
                       @bind-Value="password" />

                <!-- Confirm Password -->
                <Field Id="confirm-password"
                       Label="אימות סיסמה"
                       Icon="verified_user"
                       Type="password"
                       Placeholder="••••••••••••"
                       @bind-Value="confirmPassword" />

                <!-- Submit Button -->
                <div class="pt-3">
                    <button type="button"
                            disabled="@(isBusy || isRegistered)"
                            @onclick="RegisterAsync"
                            class="w-full py-3 px-6 bg-gradient-to-r from-purple-700 via-purple-600 to-purple-700 hover:from-purple-600 hover:via-purple-500 hover:to-purple-600 text-white font-headline-sm text-sm font-semibold flex items-center justify-center gap-2 transition-all duration-200 tracking-wide cursor-pointer purple-button-glow border border-purple-400/25 active:scale-[0.99] rounded-xl disabled:opacity-50">
                        <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">bolt</span>
                        <span>@(isBusy ? "בודקים..." : "צור חשבון")</span>
                    </button>
                </div>
            </form>

            <div class="relative my-5">
                <div class="w-full border-t border-white/5"></div>
            </div>

            <!-- Login Link -->
            <div class="text-center">
                <p class="font-body-md text-xs text-on-surface-variant">
                    כבר רשום למערכת? 
                    <a href="login" class="font-headline-sm text-xs font-semibold text-purple-400 hover:text-purple-300 hover:underline transition-all mr-1.5 inline-flex items-center gap-1">
                        <span>התחבר כאן</span>
                        <span class="material-symbols-outlined text-[14px] rtl:rotate-180">arrow_forward</span>
                    </a>
                </p>
            </div>
        </div>
    </div>
</main>

@code {
    private string username = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private string confirmPassword = string.Empty;

    private string? errorMessage;
    private bool isBusy = false;
    private bool isRegistered = false;
    private int secondsLeft = 5;

    private async Task RegisterAsync()
    {
        errorMessage = null;

        // 1. בדיקות תקינות קלט ב-C#
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(password) || string.IsNullOrWhiteSpace(confirmPassword))
        {
            errorMessage = "יש למלא את כל השדות.";
            return;
        }

        if (!MailAddress.TryCreate(email.Trim(), out _))
        {
            errorMessage = "כתובת האימייל לא תקינה.";
            return;
        }

        if (password != confirmPassword)
        {
            errorMessage = "הסיסמה ואימות הסיסמה לא זהים.";
            return;
        }

        isBusy = true;

        try
        {
            // 2. קריאה ל-API לבדיקת קיומם של שם המשתמש והאימייל
            bool usernameExists = await Http.GetFromJsonAsync<bool>(
                $"api/users/exists/{Uri.EscapeDataString(username.Trim())}");
            
            if (usernameExists)
            {
                errorMessage = "שם המשתמש כבר תפוס. בחרו שם אחר.";
                return;
            }

            bool emailExists = await Http.GetFromJsonAsync<bool>(
                $"api/users/email-exists/{Uri.EscapeDataString(email.Trim())}");
            
            if (emailExists)
            {
                errorMessage = "האימייל הזה כבר רשום במערכת.";
                return;
            }

            // 3. שמירת המשתמש ב-API
            User newUser = new User(username.Trim(), email.Trim(), password);
            HttpResponseMessage response = await Http.PostAsJsonAsync("api/users", newUser);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "ההרשמה נכשלה. נסו שוב.";
                return;
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "השרת לא זמין כרגע. נסו שוב בעוד רגע.";
            return;
        }
        finally
        {
            isBusy = false;
        }

        // 4. ספירה לאחור ומעבר לדף הכניסה
        isRegistered = true;
        while (secondsLeft > 0)
        {
            StateHasChanged();
            await Task.Delay(1000);
            secondsLeft--;
        }

        Navigation.NavigateTo("login");
    }
}