<div class="space-y-1.5">
    @if (!string.IsNullOrEmpty(Label) || !string.IsNullOrEmpty(Hint))
    {
        <div class="flex items-center justify-between">
            @if (!string.IsNullOrEmpty(Label))
            {
                <label class="block font-headline-sm text-xs font-medium text-white/90" for="@Id">
                    @Label
                </label>
            }
            @if (!string.IsNullOrEmpty(Hint))
            {
                <span class="font-label-sm text-[11px] text-text-muted">@Hint</span>
            }
        </div>
    }

    <div class="relative bg-[#07050b]/90 border border-purple-500/15 focus-within:border-purple-500/60 focus-within:ring-1 focus-within:ring-purple-500/30 transition-all rounded-xl">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-text-muted">
                <span class="material-symbols-outlined text-[18px]">@Icon</span>
            </div>
        }

        <input id="@Id"
               type="@CurrentType"
               value="@Value"
               @onchange="OnInputChanged"
               placeholder="@Placeholder"
               dir="@Dir"
               class="w-full bg-transparent border-0 py-2.5 @(string.IsNullOrEmpty(Icon) ? "pr-4" : "pr-10") @(Type == "password" ? "pl-10" : "pl-4") text-white font-label-md text-xs placeholder:text-white/20 focus:ring-0 focus:outline-none text-left" />

        @if (Type == "password")
        {
            <button type="button" 
                    @onclick="TogglePasswordVisibility"
                    aria-label="הצג סיסמה" 
                    class="absolute inset-y-0 left-0 pl-3 flex items-center text-text-muted hover:text-white transition-colors">
                <span class="material-symbols-outlined text-[18px]">
                    @(showPassword ? "visibility_off" : "visibility")
                </span>
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(Error))
    {
        <p class="font-label-sm text-[11px] text-red-400 mt-1">@Error</p>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string Dir { get; set; } = "ltr";
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? Error { get; set; }

    private bool showPassword = false;
    private string CurrentType => Type == "password" ? (showPassword ? "text" : "password") : Type;

    private Task OnInputChanged(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        return ValueChanged.InvokeAsync(Value);
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }
}