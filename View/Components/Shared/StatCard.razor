@* 
   רכיב משותף: כרטיס סטטיסטיקה
   תיאור: מציג מדד מספרי עם אייקון וכותרת בשפה עיצובית אחידה.
   מיועד ל: כל לוחות הבקרה (תלמיד, מורה, מנהל).
*@

<div class="metal-card p-5 flex items-center justify-between">
    <div>
        <p class="text-xs font-medium text-zinc-400 font-label-md">@Title</p>
        <h3 class="text-2xl font-bold text-white mt-1 font-headline-md">@Value</h3>
        @if (!string.IsNullOrEmpty(SubText))
        {
            <p class="text-[11px] text-purple-400 mt-1">@SubText</p>
        }
    </div>
    <div class="w-12 h-12 rounded-xl bg-purple-950/60 border border-purple-500/30 flex items-center justify-center text-purple-300 shrink-0">
        <span class="material-symbols-outlined text-2xl">@Icon</span>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = "analytics";
    [Parameter] public string? SubText { get; set; }
}